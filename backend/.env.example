# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Neon or local docker-compose)
DATABASE_URL=postgresql://dentalai:dentalai_dev@localhost:5432/dentalai
# Neon example:
# DATABASE_URL=postgresql://user:password@ep-xxx.ap-south-1.aws.neon.tech/dentalai?sslmode=require

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# OTP (Phase 2+)
OTP_EXPIRY_MINUTES=10
